# Copie para .env apenas no ambiente local. Em producao, configure estas variaveis
# no provedor (DigitalOcean, Heroku, Render, Railway, systemd, PM2 etc.).

# Ambiente da aplicacao. Em deploy deve ser production.
NODE_ENV=development

# Porta e host HTTP. Provedores como Heroku definem PORT automaticamente.
PORT=3000
HOST=0.0.0.0

# Reservado para a futura camada de banco. A implementacao atual usa JSON.
DATABASE_URL=json://storage

# Obrigatorio em producao. Gere um valor aleatorio forte com 32+ caracteres.
JWT_SECRET=change-me-use-a-random-value-with-32-plus-chars
JWT_TTL_SECONDS=604800
PASSWORD_HASH_ROUNDS=12
GLOBAL_ADMIN_EMAILS=gbechtold91@gmail.com

# Limites e caminhos. Caminhos relativos sao resolvidos a partir da raiz do projeto.
MAX_UPLOAD_MB=1024
STORAGE_DIR=storage
PUBLIC_DIR=public
LOG_DIR=storage/.runtime
